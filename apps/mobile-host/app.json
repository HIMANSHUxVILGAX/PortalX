{
  "expo": {
    "name": "PortelX Host",
    "slug": "portelx-host",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "portelx-host",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.portelx.host",
      "infoPlist": {
        "NSCameraUsageDescription": "PortelX needs camera access to scan QR codes for session pairing.",
        "NSFaceIDUsageDescription": "PortelX uses Face ID for biometric verification during guest sessions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.portelx.host",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-screen-capture",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PortelX to scan QR codes for session pairing."
        }
      ]
    ]
  }
}