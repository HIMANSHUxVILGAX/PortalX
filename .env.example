# Environment Mode (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Core Secret Key (32+ character CSPRNG random hex)
PORTELX_SECRET_KEY=generate_a_secure_random_256bit_hex_string_here

# Redis Configuration (Ephemerality & Volatile TTL Storage)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
SESSION_TTL_SECONDS=300

# Supabase PostgreSQL (Identity Schemas & Row Level Security)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Machine Learning / OpenAI Risk Scoring
OPENAI_API_KEY=your-openai-api-key

# Push Notifications (Alerts within < 5s)
FIREBASE_CREDENTIALS_PATH=./service-account.json

# RevenueCat Gating (Free tier vs Premium)
REVENUECAT_PUBLIC_KEY=your-revenuecat-public-key
